<Window x:Class="NovaBrowser.PrivateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Nova Private — NovaBrowser"
        Width="1060" Height="740" MinWidth="760" MinHeight="520"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Loaded="OnLoaded" Closed="OnClosed" PreviewKeyDown="OnPreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
            <RowDefinition Height="31" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="45" />
                    <ColumnDefinition Width="45" />
                    <ColumnDefinition Width="45" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="◈  Nova Private"
                           Foreground="{DynamicResource AccentBrush}"
                           FontWeight="SemiBold" FontSize="14"
                           VerticalAlignment="Center" Margin="18,0,0,0" />
                <Button Grid.Column="1" Content="—" ToolTip="Minimalizuj"
                        Style="{StaticResource ToolbarButtonStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="MinimizeClicked" />
                <Button Grid.Column="2" Content="□" ToolTip="Maksymalizuj"
                        Style="{StaticResource ToolbarButtonStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="MaximizeClicked" />
                <Button Grid.Column="3" Content="×" ToolTip="Zamknij"
                        Style="{StaticResource ToolbarButtonStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="CloseClicked" />
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="10,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="←" ToolTip="Wstecz"
                        Style="{StaticResource ToolbarButtonStyle}" Click="BackClicked" />
                <Button Grid.Column="1" Content="→" ToolTip="Dalej"
                        Style="{StaticResource ToolbarButtonStyle}" Click="ForwardClicked" />
                <Button Grid.Column="2" Content="↻" ToolTip="Odśwież"
                        Style="{StaticResource ToolbarButtonStyle}" Click="ReloadClicked" />
                <TextBox Grid.Column="3" x:Name="AddressBox"
                         Style="{StaticResource AddressBoxStyle}" Margin="10,0"
                         KeyDown="AddressKeyDown" />
                <Button Grid.Column="4" Content="+" ToolTip="Nowa karta (Ctrl+T)"
                        Style="{StaticResource ToolbarButtonStyle}" Click="NewTabClicked" />
                <Button Grid.Column="5" Content="×" ToolTip="Zamknij kartę (Ctrl+W)"
                        Style="{StaticResource ToolbarButtonStyle}" Click="CloseTabClicked" />
            </Grid>
        </Border>
        <TabControl Grid.Row="2" x:Name="PrivateTabs"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    BorderThickness="0" SelectionChanged="PrivateTabsSelectionChanged">
            <TabControl.ItemContainerStyle>
                <Style TargetType="{x:Type TabItem}">
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                    <Setter Property="Padding" Value="15,8" />
                    <Setter Property="Margin" Value="4,3,0,0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type TabItem}">
                                <Border x:Name="TabSurface" Padding="{TemplateBinding Padding}"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="10,10,0,0">
                                    <ContentPresenter ContentSource="Header" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabSurface" Property="Background"
                                                Value="{DynamicResource AccentMutedBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.ItemContainerStyle>
        </TabControl>
        <Border Grid.Row="3" Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="14,6">
            <TextBlock Text="Prywatne okno: historia nie jest zapisywana. Pobrane pliki pozostają na dysku."
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="11" TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
